{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cqing.dev/schemas/rules.schema.json",
  "title": "WhiteboxRulesRegistry",
  "description": "JSON Schema for cqing-whitebox-code rules registry",
  "type": "object",
  "required": ["version", "description", "rules"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "title",
          "intent",
          "trigger",
          "evidence",
          "exceptions",
          "remediation",
          "appliesTo"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^W\\d{2,}$"
          },
          "level": {
            "type": "string",
            "enum": ["P0", "P1", "P2"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "exceptions": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference": {
            "type": "string"
          }
        }
      }
    }
  }
}
